<Window x:Class="ServerApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server" Height="250" Width="440"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <GroupBox Header="1. Grup (Lamba Grubu)" Grid.Column="0" Margin="5">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Ellipse x:Name="lampGraphic" Width="50" Height="50" Fill="Gray" Stroke="Black" StrokeThickness="1.5" Margin="0,0,0,15" />
                <Button x:Name="btnToggleLamp" Content="Lamba Butonu" Width="140" Height="32" Click="btnToggleLamp_Click" />
            </StackPanel>
        </GroupBox>

        <GroupBox Header="2. Grup (Text Grubu)" Grid.Column="1" Margin="5">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBox x:Name="txtServerInput" Width="140" Height="30" FontSize="14" VerticalContentAlignment="Center" Margin="0,10,0,15" TextChanged="txtServerInput_TextChanged" />
                <Button x:Name="btnRandomNumber" Content="Text Butonu" Width="140" Height="32" Click="btnRandomNumber_Click" />
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>
